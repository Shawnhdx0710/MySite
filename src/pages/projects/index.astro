---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
// Sort by date, newest first
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Projects — Shawn Han"
  description="Projects and portfolio work by Shawn Han."
>
  <div class="space-y-10">
    <div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight">Projects</h1>
      <p class="mt-2 text-soft-ink">
        Things I've built at the intersection of data and sports.
      </p>
    </div>

    <div class="grid gap-6">
      {
        projects.map((p) => (
          <a href={`/projects/${p.id}`} class="card group block p-6">
            <h2 class="font-serif text-xl font-semibold group-hover:text-accent transition-colors">
              {p.data.title}
            </h2>
            <p class="mt-1 text-sm text-soft-ink">
              {p.data.date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </p>
            <p class="mt-2 text-sm text-soft-ink leading-relaxed">
              {p.data.description}
            </p>
            <div class="flex gap-2 mt-4">
              {p.data.tags.map((t) => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-soft-ink">
                  {t}
                </span>
              ))}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
