---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
// Sort by date, newest first
projects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Projects — Shawn Han"
  description="Projects and portfolio work by Shawn Han."
>
  <div class="space-y-10">
    <div>
      <h1 class="font-serif text-4xl font-semibold tracking-tight">Projects</h1>
      <p class="mt-2 text-soft-ink">
        Things I've built at the intersection of data and sports.
      </p>
    </div>

    <div class="grid gap-8">
      {
        projects.map((p) => (
          <a href={`/projects/${p.id}`} class="card group block">
            {p.data.coverImage && (
              <img
                src={p.data.coverImage.src}
                alt={p.data.title}
                class="w-full h-52 object-cover"
              />
            )}
            <div class="p-6">
              <p class="text-xs text-soft-ink tracking-wide uppercase">
                {p.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <h2 class="font-serif text-xl font-semibold mt-2 group-hover:text-accent transition-colors leading-snug">
                {p.data.title}
              </h2>
              {p.data.description && (
                <p class="mt-2 text-sm text-soft-ink leading-relaxed">
                  {p.data.description}
                </p>
              )}
              {p.data.tags && p.data.tags.length > 0 && (
                <div class="flex gap-2 mt-4">
                  {p.data.tags.map((t) => (
                    <span class="text-xs px-2.5 py-1 rounded-full bg-gray-100 text-soft-ink">
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
